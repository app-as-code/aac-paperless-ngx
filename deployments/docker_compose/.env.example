# Copy to .env and set every CHANGE_ME:  cp .env.example .env

# SECRET - set a strong value
HOMEPAGE_WIDGET_KEY=CHANGE_ME

# SECRET - set a strong value
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME

# SECRET - set a strong value
PAPERLESS_AI_TOKEN=CHANGE_ME

# REQUIRED - set for your environment
PAPERLESS_APPS=CHANGE_ME

# SECRET - set a strong value
PAPERLESS_DBPASS=CHANGE_ME

# SECRET - set a strong value
PAPERLESS_PASSPHRASE=CHANGE_ME

# SECRET - set a strong value
PAPERLESS_SECRET_KEY=CHANGE_ME

# REQUIRED - set for your environment
PAPERLESS_SOCIALACCOUNT_PROVIDERS=CHANGE_ME

# SECRET - set a strong value
PAPERLESS_TOKEN=CHANGE_ME

# SECRET - set a strong value
POSTGRES_PASSWORD=CHANGE_ME

# default: admin
PAPERLESS_ADMIN_USER=admin
